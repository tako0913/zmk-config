#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
                &bt BT_CLR   &bt BT_PRV   &bt BT_NXT   &kp N4   &kp N5   &kp N6
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &kp R    &kp T    &kp Y
                &out OUT_TOG    &kp S    &kp D    &kp F    &kp G    &kp H
                         &kp X    &kp C    &kp V    &kp B
            >;
        };
    };
 };